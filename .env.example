SECRET_KEY=replace-with-a-long-random-secret
DATA_DIR=./data
DATABASE_URL=
CHROMA_COLLECTION=enterprise_rag_chunks

# Embeddings: auto uses OpenAI when OPENAI_API_KEY is present, otherwise local sentence-transformers, then hashing fallback.
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM: auto uses OpenAI when configured, otherwise falls back to the deterministic mock LLM.
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

ENABLE_CROSS_ENCODER=false
EVIDENCE_THRESHOLD=0.45
CORS_ORIGINS=*

